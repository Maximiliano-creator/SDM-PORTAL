# Server
PORT=8788
HOST=127.0.0.1
NODE_ENV=development
LOG_LEVEL=debug

# Auth — el JWT_SECRET se genera automáticamente al primer arranque si no se define
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Database SQLite (gitignored)
DB_PATH=./data/app.db

# Upstream term_admin BLS
TERM_ADMIN_URL=http://localhost:19697
TERM_ADMIN_USERNAME=admin
# Opcional; preferir guardar la credencial desde Configuración en SDM Portal.

# CORS
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
