NODE_ENV=development
HOST=127.0.0.1
PORT=8788
DB_PATH=./data/app.db
JWT_EXPIRES_IN=4h
# Optional. Leave unset to reuse or generate a local secret; configured values must be 32+ characters.
# JWT_SECRET=
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
TERM_ADMIN_URL=http://localhost:19697
TERM_ADMIN_USERNAME=admin
# Set TERM_ADMIN_PASSWORD only when the upstream credential is not stored in portal settings.
# Set INITIAL_ADMIN_PASSWORD (12+ characters) for the first start with an empty portal database.
